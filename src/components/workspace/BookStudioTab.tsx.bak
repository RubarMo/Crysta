import React, { useState, useEffect, useMemo, useRef } from 'react';
import { Novel, Chapter, BookFormatConfig, getBookFormatting, saveBookFormatting } from '../../lib';
import { useLanguage } from '../../LanguageContext';
import { BookExportService } from '../../services/bookExportService';
import { 
  BookOpen, 
  FileText, 
  Download, 
  Layers, 
  Type, 
  Check, 
  FileCode, 
  Printer,
  Eye,
  ChevronLeft,
  ChevronRight,
  BookCopy,
  Image as ImageIcon,
  Upload,
  Trash2,
  Sun,
  Moon,
  Sparkles,
  BookMarked,
  ListOrdered,
  CheckCircle2
} from 'lucide-react';

interface BookStudioTabProps {
  activeNovel: Novel;
  chapters: Chapter[];
  onAutoSaveStatus?: (isSaving: boolean) => void;
}

export interface TrimDimensions {
  pageWidth: number;
  pageHeight: number;
  contentWidth: number;
  contentHeight: number;
  paddingX: number;
  paddingTop: number;
  footerHeight: number;
}

export function getTrimDimensions(trimSize: string = 'us_trade_6x9'): TrimDimensions {
  switch (trimSize) {
    case 'digest_5_5x8_5':
      return {
        pageWidth: 440,
        pageHeight: 680,
        contentWidth: 340,
        contentHeight: 570,
        paddingX: 48,
        paddingTop: 44,
        footerHeight: 36,
      };
    case 'pocket_5x8':
      return {
        pageWidth: 400,
        pageHeight: 640,
        contentWidth: 310,
        contentHeight: 535,
        paddingX: 44,
        paddingTop: 40,
        footerHeight: 36,
      };
    case 'a5':
      return {
        pageWidth: 460,
        pageHeight: 652,
        contentWidth: 355,
        contentHeight: 545,
        paddingX: 50,
        paddingTop: 42,
        footerHeight: 36,
      };
    case 'letter':
      return {
        pageWidth: 540,
        pageHeight: 700,
        contentWidth: 425,
        contentHeight: 585,
        paddingX: 55,
        paddingTop: 48,
        footerHeight: 36,
      };
    case 'us_trade_6x9':
    default:
      return {
        pageWidth: 470,
        pageHeight: 705,
        contentWidth: 360,
        contentHeight: 590,
        paddingX: 52,
        paddingTop: 45,
        footerHeight: 36,
      };
  }
}

export interface PageElement {
  type: 'h2' | 'p' | 'ornament';
  text: string;
  isFirstParagraph?: boolean;
  isContinuation?: boolean;
}

export interface BookPreviewPage {
  id: string;
  type: 'cover' | 'title' | 'copyright' | 'dedication' | 'epigraph' | 'foreword' | 'toc' | 'chapter' | 'epilogue' | 'acknowledgments' | 'about_author';
  title?: string;
  subtitle?: string;
  author?: string;
  publisher?: string;
  paragraphs?: string[];
  pageNumber: number | null;
  side: 'recto' | 'verso';
  chapterIndex?: number;
  coverImage?: string | null;
  tocEntries?: { title: string; pageNumber: number }[];
  elements?: PageElement[];
}

export const BookStudioTab: React.FC<BookStudioTabProps> = ({
  activeNovel,
  chapters,
  onAutoSaveStatus,
}) => {
  const { t, language } = useLanguage();
  const isRtl = language === 'ar';

  const [activeSubTab, setActiveSubTab] = useState<'metadata' | 'backmatter' | 'typography' | 'preview' | 'export'>('metadata');
  const [config, setConfig] = useState<BookFormatConfig | null>(null);
  const [isExporting, setIsExporting] = useState<string | null>(null);
  const [saveSuccess, setSaveSuccess] = useState(false);
  const [exportSuccessBanner, setExportSuccessBanner] = useState<string | null>(null);

  // Cover Image state (persisted in localStorage per novel)
  const [coverImage, setCoverImage] = useState<string | null>(() => {
    if (!activeNovel.id) return null;
    return localStorage.getItem(`crysta_cover_${activeNovel.id}`) || null;
  });

  const fileInputRef = useRef<HTMLInputElement | null>(null);

  // Preview State & Reading Theme
  const [previewPageIndex, setPreviewPageIndex] = useState(0);
  const [isSpreadView, setIsSpreadView] = useState(false);
  const [previewTheme, setPreviewTheme] = useState<'paper' | 'sepia' | 'dark'>('paper');

  // Dynamic Trim Dimensions
  const trimDims = useMemo(() => getTrimDimensions(config?.trim_size), [config?.trim_size]);

  // Handle Cover Art upload
  const handleCoverUpload = (e: React.ChangeEvent<HTMLInputElement>) => {
    const file = e.target.files?.[0];
    if (!file) return;

    const reader = new FileReader();
    reader.onload = (event) => {
      const dataUrl = event.target?.result as string;
      if (dataUrl) {
        setCoverImage(dataUrl);
        if (activeNovel.id) {
          localStorage.setItem(`crysta_cover_${activeNovel.id}`, dataUrl);
        }
      }
    };
    reader.readAsDataURL(file);
  };

  const handleRemoveCover = () => {
    setCoverImage(null);
    if (activeNovel.id) {
      localStorage.removeItem(`crysta_cover_${activeNovel.id}`);
    }
    if (fileInputRef.current) {
      fileInputRef.current.value = '';
    }
  };

  // Load config on mount
  useEffect(() => {
    if (!activeNovel.id) return;
    getBookFormatting(activeNovel.id)
      .then((cfg) => {
        setConfig(cfg);
      })
      .catch((err) => {
        console.error('Failed to load book format config:', err);
      });
  }, [activeNovel.id]);

  // Debounced auto-save config whenever it changes
  useEffect(() => {
    if (!config || !activeNovel.id) return;

    onAutoSaveStatus?.(true);
    const timer = setTimeout(() => {
      saveBookFormatting(config)
        .then(() => {
          onAutoSaveStatus?.(false);
          setSaveSuccess(true);
          setTimeout(() => setSaveSuccess(false), 2000);
        })
        .catch((err) => {
          onAutoSaveStatus?.(false);
          console.error('Failed to save formatting config:', err);
        });
    }, 600);

    return () => clearTimeout(timer);
  }, [config, activeNovel.id]);

  const updateConfig = (updates: Partial<BookFormatConfig>) => {
    if (!config) return;
    setConfig({ ...config, ...updates });
  };

  // Total Manuscript Word Count & Estimated Reading Time
  const totalManuscriptWords = useMemo(() => {
    return chapters.reduce((sum, ch) => {
      const words = ch.content.trim().split(/\s+/).filter(Boolean).length;
      return sum + words;
    }, 0);
  }, [chapters]);

  const estimatedReadingTimeMinutes = useMemo(() => {
    return Math.max(1, Math.ceil(totalManuscriptWords / 220));
  }, [totalManuscriptWords]);

  // MS Word-like Line-by-Line Paged Layout Engine
  const previewPages: BookPreviewPage[] = useMemo(() => {
    if (!config) return [];

    const pages: BookPreviewPage[] = [];
    let pageRunner = 0;

    // 0. Cover Page
    if (coverImage) {
      pageRunner++;
      pages.push({
        id: 'cover_page',
        type: 'cover',
        title: activeNovel.title,
        author: config.author_name,
        coverImage,
        pageNumber: null,
        side: 'recto',
      });
    }

    // 1. Title Page
    if (config.has_title_page) {
      pageRunner++;
      pages.push({
        id: 'title_page',
        type: 'title',
        title: activeNovel.title,
        subtitle: config.subtitle,
        author: config.author_name || (isRtl ? 'المؤلف' : 'Author'),
        publisher: config.publisher_name,
        pageNumber: null,
        side: pageRunner % 2 === 1 ? 'recto' : 'verso',
      });
    }

    // 2. Copyright Page
    if (config.has_copyright_page) {
      pageRunner++;
      pages.push({
        id: 'copyright_page',
        type: 'copyright',
        title: activeNovel.title,
        author: config.author_name || '',
        pageNumber: null,
        side: pageRunner % 2 === 1 ? 'recto' : 'verso',
      });
    }

    // 3. Dedication Page
    if (config.has_dedication && config.dedication_text) {
      pageRunner++;
      pages.push({
        id: 'dedication_page',
        type: 'dedication',
        paragraphs: config.dedication_text.split('\n').filter(Boolean),
        pageNumber: null,
        side: pageRunner % 2 === 1 ? 'recto' : 'verso',
      });
    }

    // 4. Epigraph Page
    if (config.has_epigraph && config.epigraph_quote) {
      pageRunner++;
      pages.push({
        id: 'epigraph_page',
        type: 'epigraph',
        title: config.epigraph_quote,
        author: config.epigraph_author,
        pageNumber: null,
        side: pageRunner % 2 === 1 ? 'recto' : 'verso',
      });
    }

    // Characters per line & Lines per page calculations
    const fontSize = config.font_size || 11;
    const lineSpacing = config.line_spacing || 1.45;
    const linePitch = fontSize * 1.333 * lineSpacing;
    const charsPerLine = Math.max(28, Math.floor(trimDims.contentWidth / (isRtl ? 8.2 : 7.2)));
    const maxLinesPerPage = Math.max(18, Math.floor(trimDims.contentHeight / linePitch));

    const paginateSection = (
      secTitle: string | undefined,
      rawContent: string,
      type: 'chapter' | 'foreword' | 'epilogue' | 'acknowledgments' | 'about_author',
      secIdPrefix: string,
      chIdx?: number
    ) => {
      const rawParas = rawContent.trim().split('\n\n').filter(Boolean);
      const paras = rawParas.length > 0 ? rawParas : [isRtl ? '(لا يوجد نص مكتوب بعد...)' : '(No content yet...)'];

      let currentElements: PageElement[] = [];
      let remainingLines = maxLinesPerPage;

      if (secTitle) {
        currentElements.push({ type: 'h2', text: secTitle });
        remainingLines -= 3; // Title takes ~3 line slots
      }

      paras.forEach((pText, pIdx) => {
        const isSceneBreak = pText.trim() === '* * *' || pText.trim() === config.scene_break_ornament;
        if (isSceneBreak) {
          if (remainingLines < 2) {
            // Commit current page
            pageRunner++;
            pages.push({
              id: `${secIdPrefix}_page_${pages.length + 1}`,
              type,
              title: secTitle,
              pageNumber: config.include_page_numbers ? pageRunner : null,
              side: pageRunner % 2 === 1 ? 'recto' : 'verso',
              chapterIndex: chIdx,
              elements: currentElements,
            });
            currentElements = [];
            remainingLines = maxLinesPerPage;
          }
          currentElements.push({ type: 'ornament', text: config.scene_break_ornament || '* * *' });
          remainingLines -= 2;
          return;
        }

        let textToPlace = pText.trim();
        let isFirst = pIdx === 0 && !secTitle ? false : pIdx === 0;

        while (textToPlace.length > 0) {
          const estimatedLines = Math.max(1, Math.ceil(textToPlace.length / charsPerLine));

          if (estimatedLines <= remainingLines) {
            currentElements.push({
              type: 'p',
              text: textToPlace,
              isFirstParagraph: isFirst && currentElements.filter(e => e.type === 'p').length === 0,
              isContinuation: !isFirst && textToPlace !== pText.trim(),
            });
            remainingLines -= estimatedLines;
            textToPlace = '';
          } else {
            // Paragraph overflows current page
            if (remainingLines >= 2) {
              // Split paragraph cleanly at word boundary
              const sliceChars = Math.floor(remainingLines * charsPerLine);
              let splitIndex = textToPlace.lastIndexOf(' ', sliceChars);
              if (splitIndex === -1 || splitIndex < sliceChars * 0.6) {
                splitIndex = textToPlace.indexOf(' ', sliceChars);
              }
              if (splitIndex === -1) splitIndex = sliceChars;

              const part1 = textToPlace.slice(0, splitIndex).trim();
              const part2 = textToPlace.slice(splitIndex).trim();

              currentElements.push({
                type: 'p',
                text: part1,
                isFirstParagraph: isFirst && currentElements.filter(e => e.type === 'p').length === 0,
                isContinuation: textToPlace !== pText.trim(),
              });

              // Commit full page
              pageRunner++;
              pages.push({
                id: `${secIdPrefix}_page_${pages.length + 1}`,
                type,
                title: secTitle,
                pageNumber: config.include_page_numbers ? pageRunner : null,
                side: pageRunner % 2 === 1 ? 'recto' : 'verso',
                chapterIndex: chIdx,
                elements: currentElements,
              });

              currentElements = [];
              remainingLines = maxLinesPerPage;
              textToPlace = part2;
              isFirst = false;
            } else {
              // Commit current page and put entire paragraph on next page
              pageRunner++;
              pages.push({
                id: `${secIdPrefix}_page_${pages.length + 1}`,
                type,
                title: secTitle,
                pageNumber: config.include_page_numbers ? pageRunner : null,
                side: pageRunner % 2 === 1 ? 'recto' : 'verso',
                chapterIndex: chIdx,
                elements: currentElements,
              });

              currentElements = [];
              remainingLines = maxLinesPerPage;
            }
          }
        }
      });

      if (currentElements.length > 0) {
        pageRunner++;
        pages.push({
          id: `${secIdPrefix}_page_${pages.length + 1}`,
          type,
          title: secTitle,
          pageNumber: config.include_page_numbers ? pageRunner : null,
          side: pageRunner % 2 === 1 ? 'recto' : 'verso',
          chapterIndex: chIdx,
          elements: currentElements,
        });
      }
    };

    // 5. Foreword
    if (config.has_foreword && config.foreword_content) {
      paginateSection(config.foreword_title || (isRtl ? 'مقدمة' : 'Foreword'), config.foreword_content, 'foreword', 'foreword');
    }

    // Pre-calculate Table of Contents page numbers
    const chapterTocEntries: { title: string; pageNumber: number }[] = [];
    const tocSlot = config.has_table_of_contents ? 1 : 0;
    let tocChapterRunner = pageRunner + tocSlot;

    chapters.forEach((ch, chIdx) => {
      const chTitle = ch.title || `${isRtl ? 'الفصل' : 'Chapter'} ${chIdx + 1}`;
      chapterTocEntries.push({
        title: chTitle,
        pageNumber: tocChapterRunner + 1,
      });

      // Quick estimate of chapter page count for TOC
      const rawParas = ch.content.trim().split('\n\n').filter(Boolean);
      let totalLines = 3; // for title
      rawParas.forEach((p) => {
        totalLines += Math.max(1, Math.ceil(p.length / charsPerLine));
      });
      const estPages = Math.max(1, Math.ceil(totalLines / maxLinesPerPage));
      tocChapterRunner += estPages;
    });

    // 6. Table of Contents Page
    if (config.has_table_of_contents) {
      pageRunner++;
      pages.push({
        id: 'toc_page',
        type: 'toc',
        title: isRtl ? 'فهرس المحتويات' : 'Table of Contents',
        tocEntries: chapterTocEntries,
        pageNumber: null,
        side: pageRunner % 2 === 1 ? 'recto' : 'verso',
      });
    }

    // 7. Chapters
    chapters.forEach((ch, chIdx) => {
      const chTitle = ch.title || `${isRtl ? 'الفصل' : 'Chapter'} ${chIdx + 1}`;
      paginateSection(chTitle, ch.content, 'chapter', `ch_${ch.id || chIdx}`, chIdx);
    });

    // 8. Epilogue
    if (config.has_epilogue && config.epilogue_content) {
      paginateSection(config.epilogue_title || (isRtl ? 'خاتمة' : 'Epilogue'), config.epilogue_content, 'epilogue', 'epilogue');
    }

    // 9. Acknowledgments
    if (config.has_acknowledgments && config.acknowledgments_content) {
      paginateSection(isRtl ? 'شكر وتقدير' : 'Acknowledgments', config.acknowledgments_content, 'acknowledgments', 'ack');
    }

    // 10. About the Author
    if (config.has_about_author && config.about_author_bio) {
      paginateSection(isRtl ? 'عن المؤلف' : 'About the Author', config.about_author_bio, 'about_author', 'about_author');
    }

    return pages;
  }, [config, activeNovel, chapters, isRtl, coverImage, trimDims]);

  // Keep preview page index within valid bounds
  useEffect(() => {
    if (previewPageIndex >= previewPages.length && previewPages.length > 0) {
      setPreviewPageIndex(previewPages.length - 1);
    }
  }, [previewPages.length, previewPageIndex]);

  // Pre-calculate chapter start pages for TOC from the actual paginated pages
  const realChapterTocEntries = useMemo(() => {
    const entries: { title: string; pageNumber: number }[] = [];
    const seenChapters = new Set<number>();

    previewPages.forEach((page) => {
      if (page.type === 'chapter' && page.chapterIndex !== undefined && !seenChapters.has(page.chapterIndex)) {
        seenChapters.add(page.chapterIndex);
        const ch = chapters[page.chapterIndex];
        const chTitle = ch?.title || `${isRtl ? 'الفصل' : 'Chapter'} ${page.chapterIndex + 1}`;
        entries.push({
          title: chTitle,
          pageNumber: page.pageNumber || 1,
        });
      }
    });

    return entries;
  }, [previewPages, chapters, isRtl]);

  const handleExport = async (format: 'pdf' | 'epub' | 'docx') => {
    if (!config) return;
    setIsExporting(format);
    try {
      if (format === 'epub') {
        await BookExportService.exportEpub(activeNovel, chapters, config, isRtl, coverImage);
      } else if (format === 'docx') {
        await BookExportService.exportDocx(activeNovel, chapters, config, isRtl);
      } else if (format === 'pdf') {
        BookExportService.exportPrintPdf(activeNovel, chapters, config, isRtl, coverImage, realChapterTocEntries);
      }

      setExportSuccessBanner(t('exportSuccess'));
      setTimeout(() => setExportSuccessBanner(null), 3500);
    } catch (err) {
      console.error('Export error:', err);
      alert(`${t('error')}: ${err}`);
    } finally {
      setIsExporting(null);
    }
  };

  // Get active font family style
  const getFontFamilyStyle = (font: string) => {
    switch (font) {
      case 'Dubai': return "'Dubai', 'Segoe UI', 'Amiri', sans-serif";
      case 'Amiri': return "'Amiri', 'Traditional Arabic', serif";
      case 'Cairo': return "'Cairo', sans-serif";
      case 'Scheherazade New': return "'Scheherazade New', 'Amiri', serif";
      case 'Noto Naskh Arabic': return "'Noto Naskh Arabic', 'Amiri', serif";
      case 'Almarai': return "'Almarai', sans-serif";
      case 'Readex Pro': return "'Readex Pro', sans-serif";
      case 'EB Garamond': return "'EB Garamond', Garamond, Georgia, serif";
      case 'Lora': return "'Lora', Georgia, serif";
      case 'Cinzel': return "'Cinzel', Georgia, serif";
      case 'Merriweather': return "'Merriweather', Georgia, serif";
      case 'Times New Roman': return "'Times New Roman', Times, serif";
      case 'Georgia': return "Georgia, serif";
      default: return "'Amiri', 'EB Garamond', serif";
    }
  };

  const currentFontFamily = getFontFamilyStyle(config?.font_family || 'Amiri');

  if (!config) {
    return (
      <div className="flex-1 flex items-center justify-center p-8 text-xs font-mono text-[var(--text-muted)]">
        {t('loading')}
      </div>
    );
  }

  // Visual Trim Sizes list
  const trimSizeOptions = [
    { key: 'us_trade_6x9', name: 'US Trade', size: '6" × 9"', desc: t('trimUsTradeDesc') },
    { key: 'digest_5_5x8_5', name: 'Digest', size: '5.5" × 8.5"', desc: t('trimDigestDesc') },
    { key: 'pocket_5x8', name: 'Pocket Book', size: '5" × 8"', desc: t('trimPocketDesc') },
    { key: 'a5', name: 'A5 International', size: '148 × 210 mm', desc: t('trimA5Desc') },
    { key: 'letter', name: 'Standard Letter', size: '8.5" × 11"', desc: t('trimLetterDesc') },
  ];

  return (
    <div className="flex-1 flex flex-col h-full bg-[var(--bg-canvas)] nb-dots overflow-y-auto select-none">
      {/* Header Banner */}
      <div className="p-4 md:p-6 border-b-3 border-[var(--border-ink)] bg-[var(--bg-surface-raised)] flex flex-wrap items-center justify-between gap-3 shrink-0">
        <div>
          <div className="flex items-center gap-2">
            <span className="p-1.5 bg-[var(--pastel-lavender)] text-black border-2 border-[var(--border-ink)] shadow-[2px_2px_0px_var(--shadow-ink)]">
              <BookOpen className="w-5 h-5" />
            </span>
            <h1 className="text-base md:text-lg font-heading font-black text-[var(--text-primary)]">
              {t('bookStudioHeader')}
            </h1>
          </div>
          <p className="text-xs text-[var(--text-secondary)] font-sans mt-1">
            {t('bookStudioSubtitle')}
          </p>
        </div>

        <div className="flex items-center gap-2">
          {exportSuccessBanner && (
            <span className="px-3 py-1.5 text-xs font-heading font-black bg-[var(--pastel-mint)] text-black border-2 border-[var(--border-ink)] shadow-[3px_3px_0px_var(--shadow-ink)] flex items-center gap-1.5 animate-bounce">
              <CheckCircle2 className="w-4 h-4 stroke-[3]" />
              {exportSuccessBanner}
            </span>
          )}

          {saveSuccess && (
            <span className="px-2.5 py-1 text-xs font-mono font-bold bg-[var(--pastel-mint)] text-black border-2 border-[var(--border-ink)] shadow-[2px_2px_0px_var(--shadow-ink)] flex items-center gap-1">
              <Check className="w-3.5 h-3.5 stroke-[3]" />
              {t('statusSaved')}
            </span>
          )}
        </div>
      </div>

      {/* Sub-Navigation Bar */}
      <div className="border-b-3 border-[var(--border-ink)] bg-[var(--bg-surface-raised)] flex overflow-x-auto p-2 gap-1.5 shrink-0">
        {[
          { key: 'metadata' as const, label: t('tabMetadata'), icon: FileText, color: 'var(--pastel-sky)' },
          { key: 'backmatter' as const, label: t('tabBackMatter'), icon: Layers, color: 'var(--pastel-mint)' },
          { key: 'typography' as const, label: t('tabFormatting'), icon: Type, color: 'var(--pastel-lavender)' },
          { key: 'preview' as const, label: t('tabPreview'), icon: Eye, color: 'var(--pastel-coral)' },
          { key: 'export' as const, label: t('tabExport'), icon: Download, color: 'var(--pastel-yellow)' },
        ].map(({ key, label, icon: Icon, color }) => (
          <button
            key={key}
            type="button"
            onClick={() => setActiveSubTab(key)}
            className={`flex items-center gap-2 px-3.5 py-2 text-xs font-heading font-black border-2 border-[var(--border-ink)] hover:-translate-x-0.5 hover:-translate-y-0.5 active:translate-x-[1px] active:translate-y-[1px] active:shadow-none transition-all cursor-pointer whitespace-nowrap ${
              activeSubTab === key
                ? `bg-[${color}] text-black shadow-[3px_3px_0px_var(--shadow-ink)] -translate-y-0.5`
                : 'bg-[var(--bg-surface)] text-[var(--text-primary)] shadow-[1px_1px_0px_var(--shadow-ink)] hover:bg-[var(--bg-surface-hover)]'
            }`}
            style={{ backgroundColor: activeSubTab === key ? color : undefined }}
          >
            <Icon className="w-3.5 h-3.5" />
            <span>{label}</span>
          </button>
        ))}
      </div>

      {/* Content Form Container */}
      <div className="flex-1 p-4 md:p-6 max-w-6xl w-full mx-auto space-y-6">
        
        {/* TAB 1: METADATA, COVER & FRONT MATTER */}
        {activeSubTab === 'metadata' && (
          <div className="space-y-5">
            {/* Cover Art Upload Card */}
            <div className="p-4 border-2 border-[var(--border-ink)] bg-[var(--bg-surface-raised)] shadow-[3px_3px_0px_var(--shadow-ink)]">
              <div className="flex items-center gap-2 mb-3">
                <ImageIcon className="w-4 h-4 text-[var(--text-primary)]" />
                <h3 className="text-xs font-heading font-black text-[var(--text-primary)]">
                  {t('coverArtSection')}
                </h3>
              </div>

              <div className="grid grid-cols-1 md:grid-cols-4 gap-4 items-center">
                {coverImage ? (
                  <div className="relative group w-32 h-48 border-2 border-[var(--border-ink)] shadow-[3px_3px_0px_var(--shadow-ink)] overflow-hidden bg-black shrink-0">
                    <img src={coverImage} alt="Cover Preview" className="w-full h-full object-cover" />
                    <div className="absolute inset-0 bg-black/60 opacity-0 group-hover:opacity-100 transition-opacity flex flex-col items-center justify-center gap-2 p-2">
                      <button
                        type="button"
                        onClick={() => fileInputRef.current?.click()}
                        className="px-2 py-1 text-[10px] font-heading font-black bg-[var(--pastel-yellow)] text-black border-2 border-black shadow-[1px_1px_0px_black] hover:-translate-y-0.5 cursor-pointer"
                      >
                        {t('changeCoverBtn')}
                      </button>
                      <button
                        type="button"
                        onClick={handleRemoveCover}
                        className="px-2 py-1 text-[10px] font-heading font-black bg-[var(--pastel-coral)] text-black border-2 border-black shadow-[1px_1px_0px_black] hover:-translate-y-0.5 cursor-pointer flex items-center gap-1"
                      >
                        <Trash2 className="w-3 h-3" />
                        {t('removeCoverBtn')}
                      </button>
                    </div>
                  </div>
                ) : (
                  <div
                    onClick={() => fileInputRef.current?.click()}
                    className="md:col-span-3 border-2 border-dashed border-[var(--border-ink)] bg-[var(--bg-surface)] p-6 flex flex-col items-center justify-center text-center cursor-pointer hover:bg-[var(--pastel-sky)]/20 transition-colors shadow-[2px_2px_0px_var(--shadow-ink)] group"
                  >
                    <div className="p-3 bg-[var(--pastel-sky)] border-2 border-[var(--border-ink)] shadow-[2px_2px_0px_var(--shadow-ink)] mb-2 group-hover:-translate-y-1 transition-transform">
                      <Upload className="w-5 h-5 text-black" />
                    </div>
                    <p className="text-xs font-heading font-black text-[var(--text-primary)]">
                      {t('uploadCoverBtn')}
                    </p>
                    <p className="text-[11px] text-[var(--text-secondary)] mt-1 max-w-sm">
                      {t('coverDropHint')}
                    </p>
                  </div>
                )}

                {coverImage && (
                  <div className="md:col-span-3 space-y-2 text-xs">
                    <div className="flex items-center gap-1.5 text-[var(--pastel-mint)] font-bold">
                      <Check className="w-4 h-4 text-black p-0.5 bg-[var(--pastel-mint)] border border-[var(--border-ink)]" />
                      <span className="text-[var(--text-primary)]">{t('coverAttached')}</span>
                    </div>
                    <p className="text-[11px] text-[var(--text-secondary)]">
                      {isRtl
                        ? 'سيتم استخدام هذا الغلاف كصفحة واجهة أولى في المعاينة وتضمينه رسمياً في حزم EPUB و PDF.'
                        : 'This cover image will appear as Page 1 in your book preview and be bundled into EPUB & PDF exports.'}
                    </p>
                    <button
                      type="button"
                      onClick={handleRemoveCover}
                      className="px-3 py-1.5 text-xs font-heading font-black border-2 border-[var(--border-ink)] bg-[var(--pastel-coral)] text-black shadow-[2px_2px_0px_var(--shadow-ink)] hover:-translate-x-0.5 hover:-translate-y-0.5 active:translate-x-[1px] active:translate-y-[1px] active:shadow-none transition-all cursor-pointer inline-flex items-center gap-1.5"
                    >
                      <Trash2 className="w-3.5 h-3.5" />
                      <span>{t('removeCoverBtn')}</span>
                    </button>
                  </div>
                )}

                <input
                  type="file"
                  ref={fileInputRef}
                  onChange={handleCoverUpload}
                  accept="image/png,image/jpeg,image/webp"
                  className="hidden"
                />
              </div>
            </div>

            {/* Title Page Configuration */}
            <div className="p-4 border-2 border-[var(--border-ink)] bg-[var(--bg-surface-raised)] shadow-[3px_3px_0px_var(--shadow-ink)] space-y-3">
              <label className="flex items-center gap-2 cursor-pointer">
                <input
                  type="checkbox"
                  checked={config.has_title_page}
                  onChange={(e) => updateConfig({ has_title_page: e.target.checked })}
                  className="w-4 h-4 accent-black border-2 border-[var(--border-ink)] cursor-pointer"
                />
                <span className="text-xs font-heading font-black text-[var(--text-primary)]">
                  {t('hasTitlePage')}
                </span>
              </label>

              {config.has_title_page && (
                <div className="grid grid-cols-1 md:grid-cols-2 gap-3 pt-2">
                  <div>
                    <label className="text-[11px] font-heading font-bold text-[var(--text-secondary)] block mb-1">
                      {t('subtitleLabel')}
                    </label>
                    <input
                      type="text"
                      value={config.subtitle}
                      onChange={(e) => updateConfig({ subtitle: e.target.value })}
                      placeholder="e.g., A Historical Saga"
                      className="w-full text-xs p-2 border-2 border-[var(--border-ink)] bg-[var(--bg-surface)] text-[var(--text-primary)] shadow-[2px_2px_0px_var(--shadow-ink)] focus:outline-none"
                    />
                  </div>
                  <div>
                    <label className="text-[11px] font-heading font-bold text-[var(--text-secondary)] block mb-1">
                      {t('authorNameLabel')}
                    </label>
                    <input
                      type="text"
                      value={config.author_name}
                      onChange={(e) => updateConfig({ author_name: e.target.value })}
                      placeholder="e.g., Jane Doe"
                      className="w-full text-xs p-2 border-2 border-[var(--border-ink)] bg-[var(--bg-surface)] text-[var(--text-primary)] shadow-[2px_2px_0px_var(--shadow-ink)] focus:outline-none"
                    />
                  </div>
                  <div className="md:col-span-2">
                    <label className="text-[11px] font-heading font-bold text-[var(--text-secondary)] block mb-1">
                      {t('publisherLabel')}
                    </label>
                    <input
                      type="text"
                      value={config.publisher_name}
                      onChange={(e) => updateConfig({ publisher_name: e.target.value })}
                      placeholder="e.g., Crysta Publishing House"
                      className="w-full text-xs p-2 border-2 border-[var(--border-ink)] bg-[var(--bg-surface)] text-[var(--text-primary)] shadow-[2px_2px_0px_var(--shadow-ink)] focus:outline-none"
                    />
                  </div>
                </div>
              )}
            </div>

            {/* Copyright Page */}
            <div className="p-4 border-2 border-[var(--border-ink)] bg-[var(--bg-surface-raised)] shadow-[3px_3px_0px_var(--shadow-ink)] space-y-3">
              <label className="flex items-center gap-2 cursor-pointer">
                <input
                  type="checkbox"
                  checked={config.has_copyright_page}
                  onChange={(e) => updateConfig({ has_copyright_page: e.target.checked })}
                  className="w-4 h-4 accent-black border-2 border-[var(--border-ink)] cursor-pointer"
                />
                <span className="text-xs font-heading font-black text-[var(--text-primary)]">
                  {t('hasCopyrightPage')}
                </span>
              </label>

              {config.has_copyright_page && (
                <div className="grid grid-cols-1 md:grid-cols-3 gap-3 pt-2">
                  <div>
                    <label className="text-[11px] font-heading font-bold text-[var(--text-secondary)] block mb-1">
                      {t('copyrightYearLabel')}
                    </label>
                    <input
                      type="text"
                      value={config.copyright_year}
                      onChange={(e) => updateConfig({ copyright_year: e.target.value })}
                      placeholder="2026"
                      className="w-full text-xs p-2 border-2 border-[var(--border-ink)] bg-[var(--bg-surface)] text-[var(--text-primary)] shadow-[2px_2px_0px_var(--shadow-ink)] focus:outline-none"
                    />
                  </div>
                  <div>
                    <label className="text-[11px] font-heading font-bold text-[var(--text-secondary)] block mb-1">
                      {t('isbnLabel')}
                    </label>
                    <input
                      type="text"
                      value={config.isbn}
                      onChange={(e) => updateConfig({ isbn: e.target.value })}
                      placeholder="978-3-16-148410-0"
                      className="w-full text-xs p-2 border-2 border-[var(--border-ink)] bg-[var(--bg-surface)] text-[var(--text-primary)] shadow-[2px_2px_0px_var(--shadow-ink)] focus:outline-none"
                    />
                  </div>
                  <div>
                    <label className="text-[11px] font-heading font-bold text-[var(--text-secondary)] block mb-1">
                      {t('editionNoticeLabel')}
                    </label>
                    <input
                      type="text"
                      value={config.edition_notice}
                      onChange={(e) => updateConfig({ edition_notice: e.target.value })}
                      placeholder="First Edition"
                      className="w-full text-xs p-2 border-2 border-[var(--border-ink)] bg-[var(--bg-surface)] text-[var(--text-primary)] shadow-[2px_2px_0px_var(--shadow-ink)] focus:outline-none"
                    />
                  </div>
                </div>
              )}
            </div>

            {/* Table of Contents (TOC) Toggle */}
            <div className="p-4 border-2 border-[var(--border-ink)] bg-[var(--bg-surface-raised)] shadow-[3px_3px_0px_var(--shadow-ink)] flex items-center justify-between gap-4">
              <div className="space-y-1">
                <label className="flex items-center gap-2 cursor-pointer">
                  <input
                    type="checkbox"
                    checked={config.has_table_of_contents}
                    onChange={(e) => updateConfig({ has_table_of_contents: e.target.checked })}
                    className="w-4 h-4 accent-black border-2 border-[var(--border-ink)] cursor-pointer"
                  />
                  <span className="text-xs font-heading font-black text-[var(--text-primary)]">
                    {t('hasTableOfContents')}
                  </span>
                </label>
                <p className="text-[11px] text-[var(--text-secondary)]">
                  {isRtl
                    ? 'إنشاء صفحة فهرس تلقائية بروابط سريعة وأرقام الصفحات الدقيقة لكل فصل.'
                    : 'Automatically generate a Table of Contents page with exact page numbers and clickable links.'}
                </p>
              </div>
              <ListOrdered className="w-5 h-5 text-[var(--text-secondary)] shrink-0" />
            </div>
          </div>
        )}

        {/* TAB 2: BACK MATTER & FRONT ESSAYS */}
        {activeSubTab === 'backmatter' && (
          <div className="space-y-5">
            {/* Dedication */}
            <div className="p-4 border-2 border-[var(--border-ink)] bg-[var(--bg-surface-raised)] shadow-[3px_3px_0px_var(--shadow-ink)] space-y-2">
              <label className="flex items-center gap-2 cursor-pointer mb-2">
                <input
                  type="checkbox"
                  checked={config.has_dedication}
                  onChange={(e) => updateConfig({ has_dedication: e.target.checked })}
                  className="w-4 h-4 accent-black border-2 border-[var(--border-ink)] cursor-pointer"
                />
                <span className="text-xs font-heading font-black text-[var(--text-primary)]">
                  {t('hasDedication')}
                </span>
              </label>
              {config.has_dedication && (
                <div>
                  <textarea
                    value={config.dedication_text}
                    onChange={(e) => updateConfig({ dedication_text: e.target.value })}
                    placeholder={t('dedicationLabel')}
                    rows={4}
                    className="w-full text-xs p-2.5 border-2 border-[var(--border-ink)] bg-[var(--bg-surface)] text-[var(--text-primary)] shadow-[2px_2px_0px_var(--shadow-ink)] focus:outline-none font-serif leading-relaxed"
                  />
                  <p className="text-[10px] text-[var(--text-secondary)] mt-1">
                    {isRtl ? '💡 يمكنك كتابة الإهداء في عدة أسطر مستقلة؛ سيتم حفظ التنسيق والمسافات بدقة.' : '💡 Supports multiple lines; line breaks and indentation will be preserved in print.'}
                  </p>
                </div>
              )}
            </div>

            {/* Epigraph */}
            <div className="p-4 border-2 border-[var(--border-ink)] bg-[var(--bg-surface-raised)] shadow-[3px_3px_0px_var(--shadow-ink)] space-y-2">
              <label className="flex items-center gap-2 cursor-pointer mb-2">
                <input
                  type="checkbox"
                  checked={config.has_epigraph}
                  onChange={(e) => updateConfig({ has_epigraph: e.target.checked })}
                  className="w-4 h-4 accent-black border-2 border-[var(--border-ink)] cursor-pointer"
                />
                <span className="text-xs font-heading font-black text-[var(--text-primary)]">
                  {t('hasEpigraph')}
                </span>
              </label>
              {config.has_epigraph && (
                <div className="space-y-2">
                  <textarea
                    value={config.epigraph_quote}
                    onChange={(e) => updateConfig({ epigraph_quote: e.target.value })}
                    placeholder={t('epigraphQuoteLabel')}
                    rows={2}
                    className="w-full text-xs p-2 border-2 border-[var(--border-ink)] bg-[var(--bg-surface)] text-[var(--text-primary)] shadow-[2px_2px_0px_var(--shadow-ink)] focus:outline-none"
                  />
                  <input
                    type="text"
                    value={config.epigraph_author}
                    onChange={(e) => updateConfig({ epigraph_author: e.target.value })}
                    placeholder={t('epigraphAuthorLabel')}
                    className="w-full text-xs p-2 border-2 border-[var(--border-ink)] bg-[var(--bg-surface)] text-[var(--text-primary)] shadow-[2px_2px_0px_var(--shadow-ink)] focus:outline-none"
                  />
                </div>
              )}
            </div>

            {/* Foreword / Preface */}
            <div className="p-4 border-2 border-[var(--border-ink)] bg-[var(--bg-surface-raised)] shadow-[3px_3px_0px_var(--shadow-ink)] space-y-2">
              <label className="flex items-center gap-2 cursor-pointer mb-2">
                <input
                  type="checkbox"
                  checked={config.has_foreword}
                  onChange={(e) => updateConfig({ has_foreword: e.target.checked })}
                  className="w-4 h-4 accent-black border-2 border-[var(--border-ink)] cursor-pointer"
                />
                <span className="text-xs font-heading font-black text-[var(--text-primary)]">
                  {t('hasForeword')}
                </span>
              </label>
              {config.has_foreword && (
                <div className="space-y-2">
                  <input
                    type="text"
                    value={config.foreword_title}
                    onChange={(e) => updateConfig({ foreword_title: e.target.value })}
                    placeholder={t('forewordTitleLabel')}
                    className="w-full text-xs p-2 border-2 border-[var(--border-ink)] bg-[var(--bg-surface)] text-[var(--text-primary)] shadow-[2px_2px_0px_var(--shadow-ink)] focus:outline-none font-heading font-black"
                  />
                  <textarea
                    value={config.foreword_content}
                    onChange={(e) => updateConfig({ foreword_content: e.target.value })}
                    placeholder={t('forewordContentLabel')}
                    rows={4}
                    className="w-full text-xs p-2 border-2 border-[var(--border-ink)] bg-[var(--bg-surface)] text-[var(--text-primary)] shadow-[2px_2px_0px_var(--shadow-ink)] focus:outline-none"
                  />
                </div>
              )}
            </div>

            {/* Epilogue */}
            <div className="p-4 border-2 border-[var(--border-ink)] bg-[var(--bg-surface-raised)] shadow-[3px_3px_0px_var(--shadow-ink)] space-y-2">
              <label className="flex items-center gap-2 cursor-pointer mb-2">
                <input
                  type="checkbox"
                  checked={config.has_epilogue}
                  onChange={(e) => updateConfig({ has_epilogue: e.target.checked })}
                  className="w-4 h-4 accent-black border-2 border-[var(--border-ink)] cursor-pointer"
                />
                <span className="text-xs font-heading font-black text-[var(--text-primary)]">
                  {t('hasEpilogue')}
                </span>
              </label>
              {config.has_epilogue && (
                <div className="space-y-2">
                  <input
                    type="text"
                    value={config.epilogue_title}
                    onChange={(e) => updateConfig({ epilogue_title: e.target.value })}
                    placeholder={t('epilogueTitleLabel')}
                    className="w-full text-xs p-2 border-2 border-[var(--border-ink)] bg-[var(--bg-surface)] text-[var(--text-primary)] shadow-[2px_2px_0px_var(--shadow-ink)] focus:outline-none font-heading font-black"
                  />
                  <textarea
                    value={config.epilogue_content}
                    onChange={(e) => updateConfig({ epilogue_content: e.target.value })}
                    placeholder={t('epilogueContentLabel')}
                    rows={4}
                    className="w-full text-xs p-2 border-2 border-[var(--border-ink)] bg-[var(--bg-surface)] text-[var(--text-primary)] shadow-[2px_2px_0px_var(--shadow-ink)] focus:outline-none"
                  />
                </div>
              )}
            </div>

            {/* Acknowledgments */}
            <div className="p-4 border-2 border-[var(--border-ink)] bg-[var(--bg-surface-raised)] shadow-[3px_3px_0px_var(--shadow-ink)] space-y-2">
              <label className="flex items-center gap-2 cursor-pointer mb-2">
                <input
                  type="checkbox"
                  checked={config.has_acknowledgments}
                  onChange={(e) => updateConfig({ has_acknowledgments: e.target.checked })}
                  className="w-4 h-4 accent-black border-2 border-[var(--border-ink)] cursor-pointer"
                />
                <span className="text-xs font-heading font-black text-[var(--text-primary)]">
                  {t('hasAcknowledgments')}
                </span>
              </label>
              {config.has_acknowledgments && (
                <textarea
                  value={config.acknowledgments_content}
                  onChange={(e) => updateConfig({ acknowledgments_content: e.target.value })}
                  placeholder={t('acknowledgmentsLabel')}
                  rows={4}
                  className="w-full text-xs p-2.5 border-2 border-[var(--border-ink)] bg-[var(--bg-surface)] text-[var(--text-primary)] shadow-[2px_2px_0px_var(--shadow-ink)] focus:outline-none"
                />
              )}
            </div>

            {/* About the Author */}
            <div className="p-4 border-2 border-[var(--border-ink)] bg-[var(--bg-surface-raised)] shadow-[3px_3px_0px_var(--shadow-ink)] space-y-2">
              <label className="flex items-center gap-2 cursor-pointer mb-2">
                <input
                  type="checkbox"
                  checked={config.has_about_author}
                  onChange={(e) => updateConfig({ has_about_author: e.target.checked })}
                  className="w-4 h-4 accent-black border-2 border-[var(--border-ink)] cursor-pointer"
                />
                <span className="text-xs font-heading font-black text-[var(--text-primary)]">
                  {t('hasAboutAuthor')}
                </span>
              </label>
              {config.has_about_author && (
                <textarea
                  value={config.about_author_bio}
                  onChange={(e) => updateConfig({ about_author_bio: e.target.value })}
                  placeholder={t('aboutAuthorBioLabel')}
                  rows={4}
                  className="w-full text-xs p-2.5 border-2 border-[var(--border-ink)] bg-[var(--bg-surface)] text-[var(--text-primary)] shadow-[2px_2px_0px_var(--shadow-ink)] focus:outline-none"
                />
              )}
            </div>
          </div>
        )}

        {/* TAB 3: TYPOGRAPHY & VISUAL TRIM SIZES */}
        {activeSubTab === 'typography' && (
          <div className="space-y-6">
            {/* Visual Trim Size Selector */}
            <div className="p-4 border-2 border-[var(--border-ink)] bg-[var(--bg-surface-raised)] shadow-[3px_3px_0px_var(--shadow-ink)] space-y-3">
              <label className="text-xs font-heading font-black text-[var(--text-primary)] block">
                {t('trimSizeLabel')}
              </label>

              <div className="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-5 gap-3">
                {trimSizeOptions.map((opt) => {
                  const isSelected = (config.trim_size || 'us_trade_6x9') === opt.key;
                  return (
                    <button
                      key={opt.key}
                      type="button"
                      onClick={() => updateConfig({ trim_size: opt.key })}
                      className={`p-3 border-2 border-[var(--border-ink)] flex flex-col items-center text-center transition-all cursor-pointer hover:-translate-x-0.5 hover:-translate-y-0.5 active:translate-x-[1px] active:translate-y-[1px] active:shadow-none ${
                        isSelected
                          ? 'bg-[var(--pastel-yellow)] text-black shadow-[4px_4px_0px_var(--shadow-ink)] -translate-y-1'
                          : 'bg-[var(--bg-surface)] text-[var(--text-primary)] shadow-[2px_2px_0px_var(--shadow-ink)] hover:bg-[var(--bg-surface-hover)]'
                      }`}
                    >
                      <div className="w-12 h-16 border-2 border-[var(--border-ink)] bg-[var(--bg-surface-raised)] shadow-[2px_2px_0px_var(--shadow-ink)] mb-2 flex items-center justify-center">
                        <BookOpen className="w-4 h-4 opacity-50" />
                      </div>
                      <span className="text-xs font-heading font-black">{opt.name}</span>
                      <span className="text-[10px] font-mono text-[var(--text-secondary)] mt-0.5">{opt.size}</span>
                      <span className="text-[9px] text-[var(--text-muted)] mt-1 line-clamp-2 leading-tight">
                        {opt.desc}
                      </span>
                    </button>
                  );
                })}
              </div>
            </div>

            {/* Font & Spacing Settings */}
            <div className="p-4 border-2 border-[var(--border-ink)] bg-[var(--bg-surface-raised)] shadow-[3px_3px_0px_var(--shadow-ink)] grid grid-cols-1 md:grid-cols-2 gap-4">
              <div>
                <label className="text-xs font-heading font-black text-[var(--text-primary)] block mb-1">
                  {t('fontFamilyLabel')}
                </label>
                <select
                  value={config.font_family}
                  onChange={(e) => updateConfig({ font_family: e.target.value })}
                  className="w-full text-xs p-2 border-2 border-[var(--border-ink)] bg-[var(--bg-surface)] text-[var(--text-primary)] shadow-[2px_2px_0px_var(--shadow-ink)] cursor-pointer"
                >
                  <optgroup label={isRtl ? 'الخطوط العربية' : 'Arabic Book Fonts'}>
                    <option value="Dubai">دبي (Dubai - خط عصري للنشر)</option>
                    <option value="Amiri">أميري (Amiri - نسخ أدبي كلاسيكي)</option>
                    <option value="Cairo">القاهرة (Cairo - خط صحفي معاصر)</option>
                    <option value="Scheherazade New">شهرزاد (Scheherazade - خط تراثي جميل)</option>
                    <option value="Noto Naskh Arabic">نوتو نسخ (Noto Naskh - خط موحد واضح)</option>
                    <option value="Almarai">المراعي (Almarai - خط هندسي أنيق)</option>
                    <option value="Readex Pro">ريديكس (Readex Pro - مقروئية عالية)</option>
                  </optgroup>
                  <optgroup label={isRtl ? 'الخطوط اللاتينية والروايات' : 'Latin & Western Fonts'}>
                    <option value="EB Garamond">EB Garamond (Classic Literature Serif)</option>
                    <option value="Lora">Lora (Contemporary Editorial)</option>
                    <option value="Cinzel">Cinzel (Cinematic Display)</option>
                    <option value="Merriweather">Merriweather (Readable Serif)</option>
                    <option value="Times New Roman">Times New Roman</option>
                    <option value="Georgia">Georgia</option>
                  </optgroup>
                </select>
              </div>

              <div>
                <label className="text-xs font-heading font-black text-[var(--text-primary)] block mb-1">
                  {t('sceneBreakLabel')}
                </label>
                <input
                  type="text"
                  value={config.scene_break_ornament}
                  onChange={(e) => updateConfig({ scene_break_ornament: e.target.value })}
                  placeholder="* * *"
                  className="w-full text-xs p-2 border-2 border-[var(--border-ink)] bg-[var(--bg-surface)] text-[var(--text-primary)] shadow-[2px_2px_0px_var(--shadow-ink)] focus:outline-none text-center font-mono font-bold"
                />
              </div>

              <div>
                <label className="text-xs font-heading font-black text-[var(--text-primary)] block mb-1">
                  {t('fontSizeLabel')}: {config.font_size}pt
                </label>
                <input
                  type="range"
                  min="9"
                  max="16"
                  step="0.5"
                  value={config.font_size}
                  onChange={(e) => updateConfig({ font_size: parseFloat(e.target.value) })}
                  className="w-full accent-black cursor-pointer"
                />
              </div>

              <div>
                <label className="text-xs font-heading font-black text-[var(--text-primary)] block mb-1">
                  {t('lineSpacingLabel')}: {config.line_spacing}x
                </label>
                <input
                  type="range"
                  min="1.1"
                  max="2.0"
                  step="0.05"
                  value={config.line_spacing}
                  onChange={(e) => updateConfig({ line_spacing: parseFloat(e.target.value) })}
                  className="w-full accent-black cursor-pointer"
                />
              </div>
            </div>

            {/* Paragraph Formatting Checks */}
            <div className="p-4 border-2 border-[var(--border-ink)] bg-[var(--bg-surface-raised)] shadow-[3px_3px_0px_var(--shadow-ink)] grid grid-cols-1 md:grid-cols-3 gap-4">
              <label className="flex items-center gap-2 cursor-pointer">
                <input
                  type="checkbox"
                  checked={config.first_line_indent}
                  onChange={(e) => updateConfig({ first_line_indent: e.target.checked })}
                  className="w-4 h-4 accent-black border-2 border-[var(--border-ink)] cursor-pointer"
                />
                <span className="text-xs font-heading font-bold text-[var(--text-primary)]">
                  {t('firstLineIndentLabel')}
                </span>
              </label>

              <label className="flex items-center gap-2 cursor-pointer">
                <input
                  type="checkbox"
                  checked={config.first_paragraph_drop_cap}
                  onChange={(e) => updateConfig({ first_paragraph_drop_cap: e.target.checked })}
                  className="w-4 h-4 accent-black border-2 border-[var(--border-ink)] cursor-pointer"
                />
                <span className="text-xs font-heading font-bold text-[var(--text-primary)]">
                  {t('dropCapLabel')}
                </span>
              </label>

              <label className="flex items-center gap-2 cursor-pointer">
                <input
                  type="checkbox"
                  checked={config.include_page_numbers}
                  onChange={(e) => updateConfig({ include_page_numbers: e.target.checked })}
                  className="w-4 h-4 accent-black border-2 border-[var(--border-ink)] cursor-pointer"
                />
                <span className="text-xs font-heading font-bold text-[var(--text-primary)]">
                  {t('includePageNumbersLabel')}
                </span>
              </label>
            </div>
          </div>
        )}

        {/* TAB 4: LIVE STUDIO PREVIEW */}
        {activeSubTab === 'preview' && (
          <div className="space-y-4">
            {/* Preview Toolbar */}
            <div className="p-3 border-3 border-[var(--border-ink)] bg-[var(--bg-surface-raised)] shadow-[3px_3px_0px_var(--shadow-ink)] flex flex-wrap items-center justify-between gap-3">
              {/* Pagination Controls */}
              <div className="flex items-center gap-2">
                <button
                  type="button"
                  onClick={() => setPreviewPageIndex((prev) => Math.max(0, prev - (isSpreadView ? 2 : 1)))}
                  disabled={previewPageIndex === 0}
                  className="p-1.5 border-2 border-[var(--border-ink)] bg-[var(--bg-surface)] text-[var(--text-primary)] shadow-[2px_2px_0px_var(--shadow-ink)] hover:bg-[var(--pastel-yellow)] hover:text-black hover:-translate-x-0.5 hover:-translate-y-0.5 active:translate-x-[1px] active:translate-y-[1px] active:shadow-none transition-all disabled:opacity-30 disabled:pointer-events-none cursor-pointer"
                  title={t('prevPage')}
                >
                  <ChevronRight className="w-4 h-4 rtl:rotate-0 ltr:rotate-180" />
                </button>
                <span className="text-xs font-heading font-black px-2 py-1 bg-[var(--bg-surface)] border-2 border-[var(--border-ink)] shadow-[1px_1px_0px_var(--shadow-ink)]">
                  {isSpreadView
                    ? `${previewPageIndex + 1} - ${Math.min(previewPages.length, previewPageIndex + 2)} / ${previewPages.length}`
                    : `${previewPageIndex + 1} / ${previewPages.length}`}
                </span>
                <button
                  type="button"
                  onClick={() => setPreviewPageIndex((prev) => Math.min(previewPages.length - 1, prev + (isSpreadView ? 2 : 1)))}
                  disabled={isSpreadView ? previewPageIndex >= previewPages.length - 2 : previewPageIndex >= previewPages.length - 1}
                  className="p-1.5 border-2 border-[var(--border-ink)] bg-[var(--bg-surface)] text-[var(--text-primary)] shadow-[2px_2px_0px_var(--shadow-ink)] hover:bg-[var(--pastel-yellow)] hover:text-black hover:-translate-x-0.5 hover:-translate-y-0.5 active:translate-x-[1px] active:translate-y-[1px] active:shadow-none transition-all disabled:opacity-30 disabled:pointer-events-none cursor-pointer"
                  title={t('nextPage')}
                >
                  <ChevronLeft className="w-4 h-4 rtl:rotate-0 ltr:rotate-180" />
                </button>
              </div>

              {/* View Layout & Theme Switcher */}
              <div className="flex items-center gap-2">
                {/* Reading Theme Simulator */}
                <div className="flex items-center border-2 border-[var(--border-ink)] bg-[var(--bg-surface)] p-0.5 shadow-[2px_2px_0px_var(--shadow-ink)]">
                  <button
                    type="button"
                    onClick={() => setPreviewTheme('paper')}
                    className={`px-2 py-1 text-[11px] font-heading font-black flex items-center gap-1 transition-all ${
                      previewTheme === 'paper' ? 'bg-[var(--pastel-yellow)] text-black' : 'text-[var(--text-secondary)] hover:text-[var(--text-primary)]'
                    }`}
                    title={t('themePaper')}
                  >
                    <Sun className="w-3 h-3" />
                    <span>{t('themePaper')}</span>
                  </button>
                  <button
                    type="button"
                    onClick={() => setPreviewTheme('sepia')}
                    className={`px-2 py-1 text-[11px] font-heading font-black flex items-center gap-1 transition-all ${
                      previewTheme === 'sepia' ? 'bg-[#FBF0D9] text-[#3D2B1F]' : 'text-[var(--text-secondary)] hover:text-[var(--text-primary)]'
                    }`}
                    title={t('themeSepia')}
                  >
                    <BookMarked className="w-3 h-3" />
                    <span>{t('themeSepia')}</span>
                  </button>
                  <button
                    type="button"
                    onClick={() => setPreviewTheme('dark')}
                    className={`px-2 py-1 text-[11px] font-heading font-black flex items-center gap-1 transition-all ${
                      previewTheme === 'dark' ? 'bg-black text-white' : 'text-[var(--text-secondary)] hover:text-[var(--text-primary)]'
                    }`}
                    title={t('themeDark')}
                  >
                    <Moon className="w-3 h-3" />
                    <span>{t('themeDark')}</span>
                  </button>
                </div>

                {/* Two-page Spread Toggle */}
                <button
                  type="button"
                  onClick={() => setIsSpreadView(!isSpreadView)}
                  className={`px-2.5 py-1.5 text-xs font-heading font-black border-2 border-[var(--border-ink)] shadow-[2px_2px_0px_var(--shadow-ink)] hover:-translate-x-0.5 hover:-translate-y-0.5 active:translate-x-[1px] active:translate-y-[1px] active:shadow-none transition-all cursor-pointer flex items-center gap-1.5 ${
                    isSpreadView ? 'bg-[var(--pastel-yellow)] text-black' : 'bg-[var(--bg-surface)] text-[var(--text-primary)] hover:bg-[var(--bg-surface-hover)]'
                  }`}
                >
                  <BookCopy className="w-3.5 h-3.5" />
                  <span>{isSpreadView ? t('pageSpreadView') : t('singlePageView')}</span>
                </button>
              </div>
            </div>

            {/* Reading Canvas Viewport */}
            <div 
              className={`flex justify-center items-center p-4 md:p-8 border-3 border-[var(--border-ink)] shadow-[5px_5px_0px_var(--shadow-ink)] overflow-x-auto min-h-[740px] transition-colors ${
                previewTheme === 'paper' ? 'bg-[#2A2B2E]' : previewTheme === 'sepia' ? 'bg-[#3D312A]' : 'bg-[#09090B]'
              }`}
            >
              <div className="flex gap-4 md:gap-8 justify-center items-stretch max-w-full">
                {previewPages[previewPageIndex] && (
                  <RenderPreviewPaperPage
                    page={previewPages[previewPageIndex]}
                    config={config}
                    trimDims={trimDims}
                    fontFamily={currentFontFamily}
                    isRtl={isRtl}
                    theme={previewTheme}
                  />
                )}
                {isSpreadView && previewPages[previewPageIndex + 1] && (
                  <RenderPreviewPaperPage
                    page={previewPages[previewPageIndex + 1]}
                    config={config}
                    trimDims={trimDims}
                    fontFamily={currentFontFamily}
                    isRtl={isRtl}
                    theme={previewTheme}
                  />
                )}
              </div>
            </div>
          </div>
        )}

        {/* TAB 5: EXPORT & PUBLISHING ANALYTICS */}
        {activeSubTab === 'export' && (
          <div className="space-y-6">
            {/* Publishing Readiness Statistics */}
            <div className="p-4 md:p-5 border-3 border-[var(--border-ink)] bg-[var(--bg-surface-raised)] shadow-[4px_4px_0px_var(--shadow-ink)]">
              <div className="flex items-center gap-2 mb-4">
                <Sparkles className="w-5 h-5 text-[var(--pastel-yellow)] stroke-[2.5]" />
                <h3 className="text-sm font-heading font-black text-[var(--text-primary)]">
                  {t('publishingStatsTitle')}
                </h3>
              </div>

              <div className="grid grid-cols-2 md:grid-cols-4 gap-3">
                <div className="p-3 border-2 border-[var(--border-ink)] bg-[var(--pastel-sky)] text-black shadow-[2px_2px_0px_var(--shadow-ink)]">
                  <span className="text-[10px] font-mono font-bold block opacity-75">{t('statsTotalWords')}</span>
                  <span className="text-lg font-heading font-black">{totalManuscriptWords.toLocaleString()}</span>
                </div>
                <div className="p-3 border-2 border-[var(--border-ink)] bg-[var(--pastel-mint)] text-black shadow-[2px_2px_0px_var(--shadow-ink)]">
                  <span className="text-[10px] font-mono font-bold block opacity-75">{t('statsReadingTime')}</span>
                  <span className="text-lg font-heading font-black">~{estimatedReadingTimeMinutes} {isRtl ? 'دقيقة' : 'min'}</span>
                </div>
                <div className="p-3 border-2 border-[var(--border-ink)] bg-[var(--pastel-lavender)] text-black shadow-[2px_2px_0px_var(--shadow-ink)]">
                  <span className="text-[10px] font-mono font-bold block opacity-75">{t('statsTotalPagesEst')}</span>
                  <span className="text-lg font-heading font-black">{previewPages.length} {isRtl ? 'صفحة' : 'pages'}</span>
                </div>
                <div className="p-3 border-2 border-[var(--border-ink)] bg-[var(--pastel-coral)] text-black shadow-[2px_2px_0px_var(--shadow-ink)]">
                  <span className="text-[10px] font-mono font-bold block opacity-75">{t('statsChaptersCount')}</span>
                  <span className="text-lg font-heading font-black">{chapters.length} {t('chapters')}</span>
                </div>
              </div>
            </div>

            {/* Export Cards */}
            <div className="grid grid-cols-1 md:grid-cols-3 gap-4">
              {/* EPUB 3 Card */}
              <div className="p-5 border-3 border-[var(--border-ink)] bg-[var(--pastel-sky)] text-black shadow-[4px_4px_0px_var(--shadow-ink)] flex flex-col justify-between space-y-4">
                <div>
                  <div className="p-2.5 bg-[var(--bg-surface)] border-2 border-[var(--border-ink)] inline-block shadow-[2px_2px_0px_var(--shadow-ink)] mb-3">
                    <FileCode className="w-6 h-6 text-black" />
                  </div>
                  <h3 className="text-sm font-heading font-black">EPUB 3 eBook</h3>
                  <p className="text-xs mt-1 text-black/80 font-sans leading-relaxed">
                    {isRtl
                      ? 'كتاب إلكتروني رسمي متوافق مع Apple Books و Kobo و Kindle مع إسناد الغلاف والتنسيق الكامل.'
                      : 'Standard reflowable eBook compatible with Apple Books, Kobo, and Amazon Kindle with embedded cover.'}
                  </p>
                </div>
                <button
                  type="button"
                  onClick={() => handleExport('epub')}
                  disabled={isExporting !== null}
                  className="w-full py-2.5 px-3 text-xs font-heading font-black border-2 border-[var(--border-ink)] bg-[var(--bg-surface)] text-[var(--text-primary)] shadow-[3px_3px_0px_var(--shadow-ink)] hover:bg-[var(--pastel-yellow)] hover:text-black hover:-translate-x-0.5 hover:-translate-y-0.5 active:translate-x-[1px] active:translate-y-[1px] active:shadow-none transition-all cursor-pointer disabled:opacity-50"
                >
                  {isExporting === 'epub' ? t('exporting') : t('exportEpubBtn')}
                </button>
              </div>

              {/* Word DOCX Card */}
              <div className="p-5 border-3 border-[var(--border-ink)] bg-[var(--pastel-lavender)] text-black shadow-[4px_4px_0px_var(--shadow-ink)] flex flex-col justify-between space-y-4">
                <div>
                  <div className="p-2.5 bg-[var(--bg-surface)] border-2 border-[var(--border-ink)] inline-block shadow-[2px_2px_0px_var(--shadow-ink)] mb-3">
                    <FileText className="w-6 h-6 text-black" />
                  </div>
                  <h3 className="text-sm font-heading font-black">Word Manuscript (DOCX)</h3>
                  <p className="text-xs mt-1 text-black/80 font-sans leading-relaxed">
                    {isRtl
                      ? 'مخطوطة Word منسقة قياسياً للمحررين ودور النشر مع فواصل الصفحات والخطوط المناسبة.'
                      : 'Formatted Word manuscript ready for literary agents, editors, and traditional publishers.'}
                  </p>
                </div>
                <button
                  type="button"
                  onClick={() => handleExport('docx')}
                  disabled={isExporting !== null}
                  className="w-full py-2.5 px-3 text-xs font-heading font-black border-2 border-[var(--border-ink)] bg-[var(--bg-surface)] text-[var(--text-primary)] shadow-[3px_3px_0px_var(--shadow-ink)] hover:bg-[var(--pastel-yellow)] hover:text-black hover:-translate-x-0.5 hover:-translate-y-0.5 active:translate-x-[1px] active:translate-y-[1px] active:shadow-none transition-all cursor-pointer disabled:opacity-50"
                >
                  {isExporting === 'docx' ? t('exporting') : t('exportDocxBtn')}
                </button>
              </div>

              {/* Print-Ready PDF Card */}
              <div className="p-5 border-3 border-[var(--border-ink)] bg-[var(--pastel-mint)] text-black shadow-[4px_4px_0px_var(--shadow-ink)] flex flex-col justify-between space-y-4">
                <div>
                  <div className="p-2.5 bg-[var(--bg-surface)] border-2 border-[var(--border-ink)] inline-block shadow-[2px_2px_0px_var(--shadow-ink)] mb-3">
                    <Printer className="w-6 h-6 text-black" />
                  </div>
                  <h3 className="text-sm font-heading font-black">Print-Ready PDF</h3>
                  <p className="text-xs mt-1 text-black/80 font-sans leading-relaxed">
                    {isRtl
                      ? 'جاهز للطباعة الورقية بهوامش متناسقة وترقيم مطابق لقياس الكتاب المختار.'
                      : 'Print-ready layout with standard margins, headers, and exact trim size pagination.'}
                  </p>
                </div>
                <button
                  type="button"
                  onClick={() => handleExport('pdf')}
                  disabled={isExporting !== null}
                  className="w-full py-2.5 px-3 text-xs font-heading font-black border-2 border-[var(--border-ink)] bg-[var(--bg-surface)] text-[var(--text-primary)] shadow-[3px_3px_0px_var(--shadow-ink)] hover:bg-[var(--pastel-yellow)] hover:text-black hover:-translate-x-0.5 hover:-translate-y-0.5 active:translate-x-[1px] active:translate-y-[1px] active:shadow-none transition-all cursor-pointer disabled:opacity-50"
                >
                  {isExporting === 'pdf' ? t('exporting') : t('exportPdfBtn')}
                </button>
              </div>
            </div>
          </div>
        )}
      </div>
    </div>
  );
};

/**
 * Individual Page Paper Component for Live WYSIWYG Book Preview
 */
const RenderPreviewPaperPage: React.FC<{
  page: BookPreviewPage;
  config: BookFormatConfig;
  trimDims: TrimDimensions;
  fontFamily: string;
  isRtl: boolean;
  theme: 'paper' | 'sepia' | 'dark';
}> = ({ page, config, trimDims, fontFamily, isRtl, theme }) => {
  const paperColors = {
    paper: { bg: '#FFFFFC', text: '#111111', border: '#000000' },
    sepia: { bg: '#FDF6E2', text: '#3B2F2F', border: '#3B2F2F' },
    dark: { bg: '#18181B', text: '#F4F4F5', border: '#3F3F46' },
  }[theme];

  return (
    <div
      className="border-2 shadow-[6px_6px_0px_var(--shadow-ink)] flex flex-col justify-between shrink-0 select-text transition-all relative overflow-hidden"
      style={{
        width: `${trimDims.pageWidth}px`,
        height: `${trimDims.pageHeight}px`,
        padding: `${trimDims.paddingTop}px ${trimDims.paddingX}px ${trimDims.footerHeight / 2}px ${trimDims.paddingX}px`,
        backgroundColor: paperColors.bg,
        color: paperColors.text,
        borderColor: paperColors.border,
      }}
    >
      {/* 0. Cover Page */}
      {page.type === 'cover' && page.coverImage && (
        <div className="flex-1 flex items-center justify-center -m-12 bg-black overflow-hidden relative">
          <img src={page.coverImage} alt="Cover" className="w-full h-full object-cover" />
        </div>
      )}

      {/* 1. Title Page */}
      {page.type === 'title' && (
        <div className="flex-1 flex flex-col justify-between text-center py-12">
          <div className="space-y-4 mt-12">
            <h1 className="text-3xl sm:text-4xl font-black leading-tight">{page.title}</h1>
            {page.subtitle && <p className="text-base font-serif opacity-80">{page.subtitle}</p>}
          </div>
          <div className="space-y-3 mb-6">
            <p className="text-lg font-bold">{page.author}</p>
            {page.publisher && <p className="text-xs opacity-75">{page.publisher}</p>}
          </div>
        </div>
      )}

      {/* 2. Copyright Page */}
      {page.type === 'copyright' && (
        <div className="flex-1 flex flex-col justify-end text-center text-xs space-y-2.5 pb-8 leading-relaxed opacity-90">
          <p className="font-bold text-sm">{page.title}</p>
          <p>© {config.copyright_year || '2026'} {page.author}</p>
          {config.edition_notice && <p>{config.edition_notice}</p>}
          {config.isbn && <p>ISBN: {config.isbn}</p>}
          <p className="text-[11px] opacity-75 pt-4">
            {isRtl
              ? 'جميع الحقوق محفوظة. لا يجوز نسخ أو إعادة إنتاج أي جزء من هذا الكتاب دون إذن مسبق.'
              : 'All rights reserved. No part of this publication may be reproduced without prior permission.'}
          </p>
        </div>
      )}

      {/* 3. Dedication Page */}
      {page.type === 'dedication' && (
        <div className="flex-1 flex flex-col justify-center text-center italic space-y-4 px-8">
          {page.paragraphs?.map((line, i) => (
            <p key={i} className="font-serif text-[13pt] leading-relaxed m-0">{line}</p>
          ))}
        </div>
      )}

      {/* 4. Epigraph Page */}
      {page.type === 'epigraph' && (
        <div className="flex-1 flex flex-col justify-center text-center italic space-y-5 px-8">
          <p className="text-base font-serif leading-relaxed">«{page.title}»</p>
          {page.author && <p className="text-sm font-bold not-italic opacity-85">— {page.author}</p>}
        </div>
      )}

      {/* 5. Table of Contents Page */}
      {page.type === 'toc' && (
        <div className="flex-1 flex flex-col pt-10 px-4">
          <h2 className="text-center font-black text-2xl mb-8 pb-3">
            {page.title}
          </h2>
          <div className="space-y-3.5 text-xs font-sans flex-1 overflow-y-auto pr-1 rtl:pr-0 rtl:pl-1">
            {page.tocEntries?.map((entry, idx) => (
              <div key={idx} className="flex items-baseline justify-between w-full">
                <span className="font-bold text-sm truncate max-w-[240px]">{entry.title}</span>
                <span className="flex-1 border-b border-dotted border-current/40 mx-2 mb-1 min-w-[20px]" />
                <span className="font-mono font-bold text-sm shrink-0">{entry.pageNumber}</span>
              </div>
            ))}
          </div>
        </div>
      )}

      {/* 6. Paged Content Elements (Chapters, Foreword, Epilogue, Acknowledgments, About Author) */}
      {page.elements && (
        <div
          className="w-full flex-1 overflow-hidden"
          style={{
            fontFamily,
            fontSize: `${config.font_size || 11}pt`,
            lineHeight: config.line_spacing || 1.45,
            direction: isRtl ? 'rtl' : 'ltr',
            textAlign: 'justify',
          }}
        >
          {page.elements.map((el, elIdx) => {
            if (el.type === 'h2') {
              return (
                <h2
                  key={elIdx}
                  className="font-black text-center mb-6 mt-1 leading-snug"
                  style={{ fontSize: `${(config.font_size || 11) * 1.5}pt` }}
                >
                  {el.text}
                </h2>
              );
            }

            if (el.type === 'ornament') {
              return (
                <div
                  key={elIdx}
                  className="text-center font-mono font-bold my-4 text-xs tracking-widest"
                >
                  {el.text}
                </div>
              );
            }

            const isDrop = el.isFirstParagraph && config.first_paragraph_drop_cap;

            return (
              <p
                key={elIdx}
                className="leading-relaxed"
                style={{
                  margin: '0 0 0.55em 0',
                  textIndent:
                    el.isFirstParagraph || el.isContinuation
                      ? '0'
                      : config.first_line_indent
                      ? '1.5em'
                      : '0',
                }}
              >
                {isDrop ? (
                  <>
                    <span 
                      className="font-black float-left rtl:float-right text-3xl sm:text-4xl leading-none pr-2 rtl:pl-2 pt-1 font-serif"
                    >
                      {el.text.charAt(0)}
                    </span>
                    {el.text.slice(1)}
                  </>
                ) : (
                  el.text
                )}
              </p>
            );
          })}
        </div>
      )}

      {/* Running Footer with Page Number */}
      <div 
        className="flex items-center justify-center font-serif font-bold shrink-0 select-none text-[11pt] pb-2"
        style={{ height: `${trimDims.footerHeight}px` }}
      >
        {page.pageNumber !== null ? (
          <span>{page.pageNumber}</span>
        ) : (
          <span className="opacity-0">-</span>
        )}
      </div>
    </div>
  );
};
